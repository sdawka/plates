{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Tail Worker for Plates: stores its logs and serves them behind Cloudflare Access.
  "name": "plates-logs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // No database ids on purpose: wrangler links the databases by name on deploy (creating plates-logs when
  // the account has none). APP is Plates' own database, read only.
  "d1_databases": [
    { "binding": "LOGS", "database_name": "plates-logs", "migrations_dir": "migrations" },
    { "binding": "APP", "database_name": "plates" }
  ],
  "vars": { "RETENTION_DAYS": "14" }
  // Secrets (`wrangler secret put`, from this directory):
  //   ACCESS_TEAM_DOMAIN  https://<team>.cloudflareaccess.com   (Zero Trust -> Access -> Applications -> this app)
  //   ACCESS_AUD          the application's Audience (AUD) tag
  //   SLACK_BOT_TOKEN     optional, shows names instead of Slack ids
  // Without the two Access values the Worker serves nothing (403).
}
