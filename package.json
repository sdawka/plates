{
  "name": "plates",
  "version": "0.1.0",
  "description": "Slack app that keeps every ask on someone's plate until the requester closes it. Cloudflare Workers, D1, Queues, Durable Objects.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdawka/plates.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply plates --local",
    "db:migrate:remote": "wrangler d1 migrations apply plates --remote",
    "local:e2e": "node scripts/run.mjs scripts/local-e2e.ts",
    "local:mock": "node scripts/run.mjs scripts/serve-mock.ts",
    "diagram": "node scripts/run.mjs scripts/diagram.ts",
    "eval": "node scripts/run.mjs scripts/eval.ts",
    "spike:clairic": "node scripts/run.mjs scripts/spike-clairic.ts",
    "screenshots": "node scripts/run.mjs scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "slack-cloudflare-workers": "1.3.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
