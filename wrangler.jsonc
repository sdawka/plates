{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plates",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Every invocation's logs also go to the plates-logs Tail Worker (logs/), which keeps them 14 days and
  // serves them behind Cloudflare Access. Deploy it first (docs/self-hosting.md), or delete this line.
  "tail_consumers": [{ "service": "plates-logs" }],

  // No database_id on purpose: wrangler (>= 4.45) links the database named here on deploy, creating it
  // when the account has none, so this file carries nothing specific to one account.
  "d1_databases": [{ "binding": "DB", "database_name": "plates", "migrations_dir": "migrations" }],

  "queues": {
    "producers": [{ "binding": "EXTRACT_QUEUE", "queue": "plates-extract" }],
    "consumers": [{ "queue": "plates-extract", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "plates-extract-dlq" }]
  },

  "durable_objects": {
    "bindings": [{ "name": "KEEPER", "class_name": "PlateKeeper" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlateKeeper"] }],

  // Plain vars. Everything else the Worker reads is a secret (`wrangler secret put`): see docs/configuration.md.
  "vars": {
    "EXTRACT_MODEL": "anthropic/claude-sonnet-5.5",
    "FAST_MODEL": "anthropic/claude-haiku-5.5",
    "DECIDE_MODEL": "typesafe/jev-1.14"
  }
}
