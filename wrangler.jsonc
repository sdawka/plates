{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plates",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    { "binding": "DB", "database_name": "plates", "database_id": "c4d60bac-5986-4daa-9da6-85ede934ece0", "migrations_dir": "migrations" }
  ],

  "queues": {
    "producers": [{ "binding": "EXTRACT_QUEUE", "queue": "plates-extract" }],
    "consumers": [{ "queue": "plates-extract", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "plates-extract-dlq" }]
  },

  "durable_objects": {
    "bindings": [{ "name": "KEEPER", "class_name": "PlateKeeper" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlateKeeper"] }],

  "vars": {
    "EXTRACT_MODEL": "anthropic/claude-sonnet-5.5",
    "FAST_MODEL": "anthropic/claude-haiku-5.5"
  }
  // Secrets (wrangler secret put): SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN, OPENROUTER_API_KEY
}
